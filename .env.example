# Local dev only — production values live in the droplet's own .env (see README's Deploy section)
DATABASE_URI=mongodb://localhost:27018/content_hub
# Production (DigitalOcean): reuse the existing tiptop MongoDB Atlas cluster (see
# Tiptop Website/tipopride-backend/.env for the connection string) but with its own
# database name so it never touches the live booking data, e.g.
# DATABASE_URI=mongodb+srv://<user>:<pass>@tiptop.ssvz1ex.mongodb.net/content-hub?retryWrites=true&w=majority
# NOTE: verify the Atlas database user has access to the "content-hub" database, not
# just "tiptopride-live" - Atlas users can be scoped per-database.
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Comma-separated origins allowed to call the API from the browser (frontend sites in dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004

# Shared secret each frontend site sends to trigger on-demand ISR revalidation
REVALIDATE_SECRET=change-me-too

# JSON map of site key -> frontend base URL, used to ping revalidation on publish
FRONTEND_URLS={"baby-seat":"http://localhost:3000"}
